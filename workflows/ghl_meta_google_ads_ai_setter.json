    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"status\": \"acknowledged\",\n  \"event\": \"Ad_Lead_Captured\",\n  \"message\": \"200 OK sent to GHL. n8n background setter active.\",\n  \"received_at\": new Date().toISOString()\n}",
        "options": {}
      },
      "id": "node_respond_200",
      "name": "Respond 200 OK to GHL",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        300,
        160
      ]
    },
    {
      "parameters": {
        "jsCode": "// Normalize incoming payload from Meta Ads, Google Ads or GHL webhook\nconst body = $json.body || $json;\nconst custom = body.customData || {};\n\nconst contactId = body.contact_id || body.id || \"c_\" + Math.floor(Math.random() * 899999 + 100000);\nconst fullName = body.full_name || body.name || (body.first_name ? `${body.first_name} ${body.last_name || ''}`.trim() : \"Valued Prospect\");\nconst phone = body.phone || \"+1202555\" + Math.floor(Math.random() * 8999 + 1000);\nconst email = body.email || `lead_${contactId}@clientcorp.com`;\nconst adSource = body.source || custom.ad_platform || ($('Meta Lead Ads (FB & Insta)').item ? \"Meta Ads (Instagram / FB)\" : \"Google Ads (Search / Assets)\");\nconst service = body.service || custom.service_interest || \"High-Value Consultation\";\nconst rawBudget = String(body.budget || custom.budget || \"$3,500\");\n\nlet numericBudget = 3500;\nconst budgetDigits = rawBudget.replace(/[^0-9]/g, '');\nif (budgetDigits) {\n  numericBudget = parseInt(budgetDigits, 10);\n}\n\nreturn {\n  contact_id: contactId,\n  full_name: fullName,\n  first_name: fullName.split(' ')[0],\n  email: email,\n  phone: phone,\n  ad_source: adSource,\n  service_interest: service,\n  budget_raw: rawBudget,\n  budget_numeric: numericBudget,\n  qualification_threshold: 2500,\n  created_at: new Date().toISOString()\n};"
      },
      "id": "node_normalize",
      "name": "Normalize & Sanitize Lead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        300,
        360
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://services.leadconnectorhq.com/calendars/cal_enterprise_main_01/free-slots",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer YOUR_GHL_API_KEY"
            },
            {
              "name": "Version",
              "value": "2021-07-28"
            }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "startDate",
              "value": "={{ $today.plus({days: 1}).toFormat('yyyy-MM-dd') }}"
            },
            {
              "name": "endDate",
              "value": "={{ $today.plus({days: 4}).toFormat('yyyy-MM-dd') }}"
            },
            {
              "name": "timezone",
              "value": "America/New_York"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "node_http_slots",
      "name": "Query GHL Calendar Available Slots",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        540,
        360
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Lead Information:\nName: {{$('Normalize & Sanitize Lead').item.json.full_name}}\nService: {{$('Normalize & Sanitize Lead').item.json.service_interest}}\nBudget: {{$('Normalize & Sanitize Lead').item.json.budget_raw}} (${{$('Normalize & Sanitize Lead').item.json.budget_numeric}})\nCampaign Source: {{$('Normalize & Sanitize Lead').item.json.ad_source}}\nAvailable Slots: Tomorrow 2:30 PM EST, Thursday 10:30 AM EST",
        "options": {
          "systemMessage": "You are an Autonomous AI Appointment Setter for GoHighLevel CRM.\n- If budget >= $2,500: mark qualified=true, draft high-converting SMS acknowledging their ad source, propose slots.\n- If budget < $2,500: offer $99/mo zero-down financing. If refused, mark qualified=false.\n\nOutput JSON:\n{\n  \"qualified\": true,\n  \"intent_score\": 96,\n  \"recommended_slot\": \"Tomorrow at 2:30 PM EST\",\n  \"sms_pitch\": \"Hi [Name], thanks for inquiring through our ad! We have VIP consultation slots open tomorrow at 2:30 PM EST. Would that work?\"\n}"
        }
      },
      "id": "node_langchain_agent",
      "name": "LangChain Autonomous Setter Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.6,
      "position": [
        800,
        360
      ]
    },
    {
      "parameters": {
        "model": "gpt-4o-mini",
        "options": {
          "temperature": 0.2
