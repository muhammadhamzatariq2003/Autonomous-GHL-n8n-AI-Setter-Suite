  "automations": [
    {
      "name": "Meta/Google Ads Inbound to n8n Webhook Trigger",
      "trigger": "Form Submitted / Contact Created",
      "actions": [
        "POST to n8n Webhook: /ghl-meta-ad-inbound",
        "Apply Tag: AI_Processing"
      ]
    },
    {
      "name": "No-Show Shield 24h & 2h Multi-Channel Reminders",
      "trigger": "Appointment Status = Confirmed",
      "actions": [
        "Wait 24 Hours before event -> Send SMS with 1-click reschedule link",
        "Wait 2 Hours before event -> Send SMS & WhatsApp with location pin"
      ]
    }
  ]
