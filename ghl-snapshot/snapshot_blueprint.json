  "custom_fields": [
    {
      "name": "AI Qualification Score",
      "key": "ai_qualification_score",
      "dataType": "NUMERICAL"
    },
    {
      "name": "AI Objection Type",
      "key": "ai_objection_type",
      "dataType": "DROPDOWN",
      "options": [
        "Timing",
        "Pricing_Insurance",
        "Consult_Fee",
        "Budget_Constraint",
        "None"
      ]
    },
    {
      "name": "Verified Client Budget",
      "key": "verified_client_budget",
      "dataType": "MONEY"
    },
    {
      "name": "AI Confirmed Calendar Slot",
      "key": "ai_confirmed_calendar_slot",
      "dataType": "TEXT"
    },
    {
      "name": "AI Conversation Audit Log",
      "key": "ai_conversation_audit_log",
      "dataType": "LARGE_TEXT"
    }
  ],
  "tags": [
    "AI_Qualified_Tier1",
    "AI_Appointment_Booked",
    "AI_Disqualified",
    "Low_Budget_Spam",
    "Objection_Resolved_Pricing",
    "Objection_Resolved_Schedule"
